---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Viewer from "../components/Viewer";
import Portfolio from "../components/Portfolio";
import LandingEffectController from "../components/LandingEffectController";

import "../styles/globals.css";
import "../styles/style.css";
import { Separator } from "@/components/ui/separator";
---

<Layout title="My Portfolio">
  <!-- NOTE: the special titlebar asset that we will be making -->
  <!-- <Navbar client:only="react" /> -->

  <!-- NOTE: the landing page -->
  <div
    class="relative h-screen w-full bg-[linear-gradient(0deg,var(--color-primary)0%,var(--color-secondary)100%)]"
  >
    <!-- <div
      class="absolute z-[9] flex h-screen w-full items-center justify-center"
    >
      <div class="text-center">
        <h1 class="m-0 text-5xl font-bold text-[var(--text-primary)]">
          Ethan Zeronik
        </h1>
        <h2 class="m-0 text-2xl font-bold text-[var(--text-secondary)]">
          Software Engineer
        </h2>
      </div>
    </div> -->

    <!-- NOTE: applies a random effect to the landing page -->
    <LandingEffectController client:only="react" />
  </div>

  <main>
    <!-- NOTE: a simple about me page -->
    <section id="about-me" class="content">
      <h2>About Me</h2>
      <p>
        Hi there 🤝 my name is Ethan Zeronik. Always learning, I love to try
        exciting new technologies. Whether it is a new microcontroller or a
        backend framework that provides better performance, I am always striving
        to learn about the next big thing. I like to spend my free time
        assembling Gunpla models or 3d printing various odds and ends. I am
        passionate about always doing the best I can, both in professional and
        personal pursuits.
      </p>
      <h3>Skills</h3>
      <p>Typescript, Javascript, Git, C, C#, Powershell, SQL</p>
      <h3>Education</h3>
      <p>
        <strong>Purdue University:</strong> 2019-2023, Bachelors in CNIT with a general
        specification
        <br />
        <br />
        <strong>Heritage Christian:</strong> 2006-2019, Highschool diploma
      </p>
    </section>

    <Separator className="m-12 mx-auto w-11/12" />

    <!-- NOTE: a grid of all projects in my portfolio -->
    <section id="portfolio" class="content">
      <h2>Portfolio</h2>
      <Portfolio client:only="react" />
    </section>

    <!-- NOTE: the "footer" of the site -->
    <section id="footer" class="content">
      <div>
        <a href="https://github.com/ejzeronimo" target="_blank">Github</a>
        |
        <a href="https://www.linkedin.com/in/ethanzeronik/" target="_blank"
          >LinkedIn</a
        >
        |
        <a
          href="https://discordapp.com/users/210578280485617665"
          target="_blank">Discord</a
        >
        |
        <a href="mailto:ejzeronik@gmail.com" target="_blank">Email</a>
      </div>
    </section>
  </main>
</Layout>
